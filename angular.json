{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "burhani-seal-centre": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/burhani-seal-centre",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              { "glob": "**/*", "input": "public" },
              { "glob": "**/*", "input": "src/assets", "output": "assets" }
            ],
            "stylePreprocessorOptions": {
              "includePaths": ["src/styles"]
            },
            "styles": [
              "node_modules/@fontsource-variable/inter/index.css",
              "node_modules/@fontsource-variable/playfair-display/index.css",
              "node_modules/@fontsource-variable/playfair-display/wght-italic.css",
              "node_modules/@fontsource-variable/montserrat/index.css",
              "node_modules/@fortawesome/fontawesome-free/css/all.min.css",
              "src/styles/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "700kB", "maximumError": "1.5MB" },
                { "type": "anyComponentStyle", "maximumWarning": "16kB", "maximumError": "24kB" }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "burhani-seal-centre:build:production" },
            "development": { "buildTarget": "burhani-seal-centre:build:development" }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
